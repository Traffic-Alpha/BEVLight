__pycache__/
*.py[cod]
*$py.class

.DS_Store
.idea/
.vscode/

.pytest_cache/
.mypy_cache/
.ruff_cache/

# Generated, expensive: episode trajectories, rendered frames, feature caches.
# Hours of Blender live here; this is the one that is not cheap to recreate.
data/

# Generated, cheap: training runs, backbone weights, figures, logs, result JSON.
# Safe to delete; every command that writes here can be rerun.
runs/
wandb/

*.egg-info/
build/
dist/

# Internal design notes and discussion, not part of the public repository.
docs/

*.blend1

# Per-junction scenario data: 296M of GeoTIFF, 68M of .blend, plus the networks
# and routes the build commands regenerate. One .tif is 100M, which GitHub
# rejects outright. The two hand-calibrated scripts per junction are code and
# stay tracked; everything beside them is rebuildable.
/scenarios/**
!/scenarios/*/
!/scenarios/*/config.py
!/scenarios/*/generate_routes.py

# The paper is its own Overleaf-synced git repository; never nest it in this one.
/overleaf_paper/
